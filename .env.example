# Google OAuth client (Web application) from console.cloud.google.com
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Public URL of this server. Google's redirect URI is BASE_URL + /auth/callback
BASE_URL=http://localhost:8000

# Who may query. At least one of the two must be set or the server refuses to start.
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=guest@example.net

# Plausible API key with Stats API access
PLAUSIBLE_API_KEY=xxx

# Signs this server's own access tokens. Without it, a restart signs everyone out.
JWT_SIGNING_KEY=

# Where to persist OAuth client registrations. Unset means in-memory.
CLIENT_STORAGE_PATH=

# Where to record per-person usage. Unset turns usage tracking off.
USAGE_PATH=
